# New generated policies are ignored by default; published archives are explicitly
# tracked through Git LFS. Retain the required reset dataset as ordinary Git data.
*.pt
*.onnx
*.onnx.data
*.jit
!src/isaaclab_tutorial/assets/reset_poses.pt

# Published model archives live here; bulky failed experiments stay local.
!/checkpoints/**/*.pt
!/checkpoints/**/*.onnx
!/checkpoints/**/*.onnx.data
!/checkpoints/**/*.jit
/checkpoints/local_experiments/
